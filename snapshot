#!/usr/bin/env bash

set -euo pipefail

DEFAULT_MAX_AGE=60

function main() {

    local rootDevice
    rootDevice=$(findmnt -no SOURCE --nofsroot /)
    local maxAlterInTagen="$1"

    ensure_root_permissions
    ensure_btrfs "${rootDevice}"

    local mountDir
    mountDir="$(mktemp -d)"
    local snapshots="${mountDir}/@snapshots"
    sudo mount -o subvolid=0 "${rootDevice}" "${mountDir}"

    ensure_snapshots_subvolume "$snapshots"
    local newSnapshotsRoot
    newSnapshotsRoot="${snapshots}/$(date +%Y-%m-%d_%H:%M:%S)"

    remove_old_snapshots "${maxAlterInTagen}" "${snapshots}" "${mountDir}"
    create_snapshots "${mountDir}" "${newSnapshotsRoot}"

    sudo umount "${mountDir}"
    rmdir "${mountDir}"

}

function parse_args() {
    maxAlterInTagen=${DEFAULT_MAX_AGE}
    while [[ $# -gt 0 ]]; do
        case "${1}" in
            -h | --help)
                print_usage
                exit 0
                ;;
            --max-age)
                maxAlterInTagen="$2"
                shift
                ;;
            *)
                echo "Unbekannte Option '$1'. Abbruch." >&2
                exit 1
                ;;
        esac
        shift
    done
}

function print_usage() {
    cat <<EOF
Usage: $(basename "${BASH_SOURCE[0]}") [-h|--help] [--max-age <AGE>]

Creates a read-only BtrFS snapshot of all top-level subvolumes of the
root filesystem, first deleting any snapshots older than --max-age days.

Requires the root filesystem to be on BtrFS; otherwise the script exits
without taking a snapshot (exit code 0). This allows embedding the script in a
dist-upgrade alias without breaking it on non-BtrFS systems.

Snapshots are stored under the @snapshots subvolume, each in a directory
named after its creation time (format: YYYY-MM-DD_HH:MM:SS).

The script will ask for root permissions via sudo if not run as root.

Available options:

-h, --help      Print this help and exit
--max-age       Maximum age of snapshots in days. Older snapshots are deleted
                before new ones are created. Defaults to ${DEFAULT_MAX_AGE}.
EOF

}

function ensure_root_permissions() {
    if ! sudo -v; then
        echo Unverzichtbare Rootrechte sind nicht verfügbar. Abbruch! >&2
        exit 1
    fi
}

function ensure_btrfs() {
    local rootDevice="$1"
    # Wenn das Dateisystem auf $rootDevice nicht BtrFS ist, sind Schnappschüsse
    # nicht möglich. Dies wird hier geprüft. Ggf. wird das Skript hier
    # verlassen.
    #
    # Um das snapshot-Skript auch auf nicht-BtrFS-Systemen im distup-Alias
    # verwenden zu können, ist der Exit-Code trotzdem "0".
    if [[ $(lsblk -no FSTYPE "${rootDevice}") != "btrfs" ]]; then
        echo Gerät "${rootDevice}" ist kein BtrFS-Dateisystem. Es wird kein Snapshot gemacht! >&2
        exit 0
    fi
}

function ensure_snapshots_subvolume() {
    local snapshots="$1"
    if ! [[ -d "$snapshots" ]]; then
        sudo btrfs subvol create "$snapshots"
    fi

    if ! sudo btrfs subvolume show "$snapshots" &>/dev/null; then
        echo "Verzeichnis für Snapshots existiert, aber ist kein BtrFS-Subvolume. Fahre trotzdem fort." >&2
    fi
}

function remove_old_snapshots() {
    # Lösche alle Snapshots, die älter sind als $maxTage Tage.
    local maxTage="$1"
    local snapshots="$2"
    local mountDir="$3"
    local threshold
    threshold=$(date --date "${maxTage} days ago" +%s)

    readarray -d '' allSnapshots < <(find "${snapshots}" -mindepth 2 -maxdepth 2 -print0)
    readarray -d '' allDateDirs < <(printf '%s\0' "${allSnapshots[@]}" | xargs -0 dirname -z)
    readarray -d '' allSnapshotDates < <(
        printf '%s\0' "${allDateDirs[@]}" |
            xargs -0 basename --multiple --zero |
            sed -z 's/_/ /g'
    )
    # The following line would break if some basename consisted of several
    # lines, each being a valid date. However, this would be a violation of the
    # snapshot folder name requirements.
    readarray allWhenCreatedTimestamps < <(printf '%s\n' "${allSnapshotDates[@]}" | date +%s -f -)

    local -a toDeleteSnapshots=()
    local -A toDeleteDateDirs=()
    local idx
    for idx in "${!allWhenCreatedTimestamps[@]}"; do # iterate over all indices of the array
        local whenCreated="${allWhenCreatedTimestamps[idx]}"
        if [[ "${whenCreated}" -gt "${threshold}" ]]; then
            continue
        fi
        toDeleteSnapshots+=("${allSnapshots[idx]}")
        toDeleteDateDirs["${allDateDirs[idx]}"]=1
    done

    if [[ ${#toDeleteSnapshots[@]} -gt 0 ]]; then
        printf '%s\0' "${toDeleteSnapshots[@]}" |
            xargs -0 sudo btrfs subvolume delete --commit-after |
            sed "s!${mountDir}/!!g"
    fi

    if [[ ${#toDeleteDateDirs[@]} -gt 0 ]]; then
        printf '%s\0' "${!toDeleteDateDirs[@]}" | xargs -0 sudo rmdir
    fi
}

function create_snapshots() {
    # Create read-only snapshots of all **top-level** subvolumes
    #
    # Only top-level subvolumes are snapshotted. On modern Btrfs systems, there
    # tend to be plenty of subvolumes, most of which are not relevant for the
    # user. The Docker volumes management would be an example of that.
    #
    # By limiting the snapshots to top-level subvolumes, only the most relevant
    # data is snapshotted: root as @, /home as @home and a few others. This
    # keeps the snapshot size small and manageable.
    local mountDir="${1}"
    local dest="${2}"
    sudo mkdir "${dest}"
    sudo btrfs subvolume list "${mountDir}" |
        grep -Ev '/|@snapshots' |
        cut -d' ' -f9 |
        xargs -P0 -I{} sudo btrfs subvolume "snapshot" -r "${mountDir}/{}" "${dest}/{}" |
        sed "s!${mountDir}/!!g"
}

parse_args "$@"
main "${maxAlterInTagen}"
